{
  "name": "@joxpg/akretrix-ui",
  "version": "0.1.0",
  "description": "Shared transversal UI components for AkreTrix applications (Astro, React, Vite)",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles/theme.css"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joxpg/akretrix-ui.git"
  },
  "keywords": [
    "akretrix",
    "design-system",
    "components",
    "react",
    "astro",
    "contact-modal"
  ],
  "author": "AkreTrix",
  "license": "UNLICENSED",
  "scripts": {
    "build": "rm -rf dist && tsc && mkdir -p dist/styles && cp src/styles/theme.css dist/styles/theme.css",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/exports.test.mjs",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "dependencies": {
    "lucide-react": "^0.380.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.4.5"
  }
}
