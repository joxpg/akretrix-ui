{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "declaration": true,
    "declarationMap": false,
    "sourceMap": false,
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "typeRoots": [
      "../akretrix-elearning/frontend/node_modules/@types",
      "./node_modules/@types"
    ],
    "paths": {
      "react": ["../akretrix-elearning/frontend/node_modules/@types/react", "react"],
      "react-dom": ["../akretrix-elearning/frontend/node_modules/@types/react-dom", "react-dom"],
      "lucide-react": ["../akretrix-elearning/frontend/node_modules/lucide-react", "lucide-react"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["dist"]
}
